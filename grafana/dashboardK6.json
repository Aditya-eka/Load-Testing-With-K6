        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  time_bucket('1 minute', ts) AS waktu,\r\n  substring(metric FROM '^diagnosis_[^_]+_(.+)$') AS api,\r\n\r\n  -- Server Bottleneck\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor6' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor7' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor8' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor9' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor10' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_motor11' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_peristaltic1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_peristaltic2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_peristaltic3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_peristaltic4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_peristaltic5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_pump1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_server_bottleneck_servicing_pump2' THEN value ELSE 0 END) AS server_bottleneck,\r\n\r\n  -- Network Delay\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor6' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor7' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor8' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor9' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor10' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_motor11' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_peristaltic1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_peristaltic2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_peristaltic3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_peristaltic4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_peristaltic5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_pump1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_network_delay_servicing_pump2' THEN value ELSE 0 END) AS network_delay,\r\n\r\n  -- Slow Receiving\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor6' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor7' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor8' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor9' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor10' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_motor11' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_peristaltic1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_peristaltic2' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_peristaltic3' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_peristaltic4' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_peristaltic5' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_pump1' THEN value ELSE 0 END) +\r\n  SUM(CASE WHEN metric = 'diagnosis_slow_receiving_servicing_pump2' THEN value ELSE 0 END) AS slow_receiving\r\n\r\nFROM samples\r\nWHERE\r\n  metric IN (\r\n    -- List all 3x18 = 54 metric names\r\n    'diagnosis_server_bottleneck_servicing_motor1',\r\n    'diagnosis_server_bottleneck_servicing_motor2',\r\n    'diagnosis_server_bottleneck_servicing_motor3',\r\n    'diagnosis_server_bottleneck_servicing_motor4',\r\n    'diagnosis_server_bottleneck_servicing_motor5',\r\n    'diagnosis_server_bottleneck_servicing_motor6',\r\n    'diagnosis_server_bottleneck_servicing_motor7',\r\n    'diagnosis_server_bottleneck_servicing_motor8',\r\n    'diagnosis_server_bottleneck_servicing_motor9',\r\n    'diagnosis_server_bottleneck_servicing_motor10',\r\n    'diagnosis_server_bottleneck_servicing_motor11',\r\n    'diagnosis_server_bottleneck_servicing_peristaltic1',\r\n    'diagnosis_server_bottleneck_servicing_peristaltic2',\r\n    'diagnosis_server_bottleneck_servicing_peristaltic3',\r\n    'diagnosis_server_bottleneck_servicing_peristaltic4',\r\n    'diagnosis_server_bottleneck_servicing_peristaltic5',\r\n    'diagnosis_server_bottleneck_servicing_pump1',\r\n    'diagnosis_server_bottleneck_servicing_pump2',\r\n\r\n    'diagnosis_network_delay_servicing_motor1',\r\n    'diagnosis_network_delay_servicing_motor2',\r\n    'diagnosis_network_delay_servicing_motor3',\r\n    'diagnosis_network_delay_servicing_motor4',\r\n    'diagnosis_network_delay_servicing_motor5',\r\n    'diagnosis_network_delay_servicing_motor6',\r\n    'diagnosis_network_delay_servicing_motor7',\r\n    'diagnosis_network_delay_servicing_motor8',\r\n    'diagnosis_network_delay_servicing_motor9',\r\n    'diagnosis_network_delay_servicing_motor10',\r\n    'diagnosis_network_delay_servicing_motor11',\r\n    'diagnosis_network_delay_servicing_peristaltic1',\r\n    'diagnosis_network_delay_servicing_peristaltic2',\r\n    'diagnosis_network_delay_servicing_peristaltic3',\r\n    'diagnosis_network_delay_servicing_peristaltic4',\r\n    'diagnosis_network_delay_servicing_peristaltic5',\r\n    'diagnosis_network_delay_servicing_pump1',\r\n    'diagnosis_network_delay_servicing_pump2',\r\n\r\n    'diagnosis_slow_receiving_servicing_motor1',\r\n    'diagnosis_slow_receiving_servicing_motor2',\r\n    'diagnosis_slow_receiving_servicing_motor3',\r\n    'diagnosis_slow_receiving_servicing_motor4',\r\n    'diagnosis_slow_receiving_servicing_motor5',\r\n    'diagnosis_slow_receiving_servicing_motor6',\r\n    'diagnosis_slow_receiving_servicing_motor7',\r\n    'diagnosis_slow_receiving_servicing_motor8',\r\n    'diagnosis_slow_receiving_servicing_motor9',\r\n    'diagnosis_slow_receiving_servicing_motor10',\r\n    'diagnosis_slow_receiving_servicing_motor11',\r\n    'diagnosis_slow_receiving_servicing_peristaltic1',\r\n    'diagnosis_slow_receiving_servicing_peristaltic2',\r\n    'diagnosis_slow_receiving_servicing_peristaltic3',\r\n    'diagnosis_slow_receiving_servicing_peristaltic4',\r\n    'diagnosis_slow_receiving_servicing_peristaltic5',\r\n    'diagnosis_slow_receiving_servicing_pump1',\r\n    'diagnosis_slow_receiving_servicing_pump2'\r\n  )\r\n  AND ts >= NOW() - INTERVAL '1 hour'\r\nGROUP BY waktu, api\r\nORDER BY waktu ASC, api ASC;",
